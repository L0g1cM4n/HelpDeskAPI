								"exec": [
									"pm.test(\"Creación exitosa devuelve 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"const j = pm.response.json();",
									"pm.collectionVariables.set(\"ticketIdAna\", j.id);",
									"pm.test(\"El servidor definió estado ABIERTO\", function () {",
									"    pm.expect(j.estado).to.eql(\"ABIERTO\");",
									"});",
									"pm.test(\"El SLA quedó calculado y no vencido\", function () {",
									"    pm.expect(j.slaVenceEn).to.exist;",
									"    pm.expect(j.vencido).to.eql(false);",
									"});"
								]
							}
						}
					],
					"request": {
