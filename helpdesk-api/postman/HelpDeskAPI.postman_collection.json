							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"La API está viva\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/ping",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ping"]
						}
					},
					"response": []
				},
				{
					"name": "02 Registro usuario (Ana)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Registro exitoso devuelve 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"const j = pm.response.json();",
									"pm.test(\"Devuelve ambos tokens\", function () {",
									"    pm.expect(j.accessToken).to.be.a('string');",
									"    pm.expect(j.refreshToken).to.be.a('string');",
									"});",
									"pm.collectionVariables.set(\"accessTokenUsuario\", j.accessToken);",
									"pm.collectionVariables.set(\"refreshTokenUsuario\", j.refreshToken);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Ana\",\n  \"email\": \"ana@correo.com\",\n  \"password\": \"123456\"\n}",
